{
  "name": "todoist",
  "author": "Pebble",
  "version": "1.0.2",
  "pebble": {
    "displayName": "Todoist",
    "uuid": "0d520cba-326c-4a22-a269-d1ab1ae38977",
    "sdkVersion": "3",
    "usesPermissions": [
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "api.todoist.com"
          ]
        }
      }
    ],
    "plugin": {
      "description": "Creates Todoist tasks as reminders and exposes active projects as reminder destinations.",
      "script": "plugin.js",
      "sources": [
        {
          "category": "reminders",
          "items": [
            "list"
          ],
          "properties": {
            "name": [
              "shortText"
            ],
            "destination": [
              "shortText"
            ],
            "url": [
              "longText"
            ]
          },
          "supportsMultiple": true,
          "callerPermissions": [],
          "suggestedRefreshIntervalSec": 900
        },
        {
          "category": "reminders",
          "items": [
            "configured"
          ],
          "properties": {
            "name": [
              "shortText"
            ],
            "configured": [
              "boolean",
              "shortText"
            ]
          },
          "supportsMultiple": false,
          "callerPermissions": [],
          "suggestedRefreshIntervalSec": 60
        }
      ],
      "actions": [
        {
          "name": "create_reminder",
          "description": "Create a Todoist task. Use instanceId from reminders/list to choose a project; omit it for Inbox. due_iso is an absolute ISO-8601 instant, timezone is its IANA time-zone context, and notify_before_ms is rounded to Todoist's whole-minute reminder precision.",
          "parameters": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "description": "Reminder title."
              },
              "due_iso": {
                "type": "string",
                "format": "date-time",
                "description": "Optional absolute due instant in ISO-8601 format."
              },
              "timezone": {
                "type": "string",
                "minLength": 1,
                "description": "IANA time-zone context. Required whenever due_iso is supplied."
              },
              "notify_before_ms": {
                "type": "integer",
                "minimum": 0,
                "description": "Optional notification lead time in milliseconds. Todoist stores whole minutes."
              },
              "instanceId": {
                "type": "string",
                "minLength": 1,
                "description": "Optional Todoist project ID from reminders/list. Omit for Inbox."
              }
            },
            "required": [
              "title"
            ],
            "allOf": [
              {
                "if": {
                  "required": [
                    "due_iso"
                  ]
                },
                "then": {
                  "required": [
                    "timezone"
                  ]
                }
              }
            ],
            "additionalProperties": false
          },
          "targets": [
            "reminders/list"
          ],
          "destructive": false,
          "requiresConfirmation": false,
          "callerPermissions": []
        }
      ],
      "oauth": {
        "todoist": {}
      }
    },
    "configPage": "config.html"
  }
}
