{
  "name": "ticktick",
  "author": "Pebble",
  "version": "1.0.2",
  "pebble": {
    "displayName": "TickTick",
    "uuid": "b1740936-c2e8-4dd6-b4cf-a85058109ac0",
    "sdkVersion": "3",
    "usesPermissions": [
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "api.ticktick.com"
          ]
        }
      }
    ],
    "plugin": {
      "description": "Creates reminders in TickTick and exposes the user's open TickTick lists so an agent can choose a destination.",
      "script": "plugin.js",
      "sources": [
        {
          "category": "reminders",
          "items": [
            "list"
          ],
          "properties": {
            "name": [
              "shortText"
            ],
            "destination": [
              "shortText"
            ],
            "url": [
              "longText"
            ]
          },
          "supportsMultiple": true,
          "callerPermissions": [],
          "suggestedRefreshIntervalSec": 900
        },
        {
          "category": "reminders",
          "items": [
            "configured"
          ],
          "properties": {
            "name": [
              "shortText"
            ],
            "configured": [
              "boolean",
              "shortText"
            ]
          },
          "supportsMultiple": false,
          "callerPermissions": [],
          "suggestedRefreshIntervalSec": 60
        }
      ],
      "actions": [
        {
          "name": "create_reminder",
          "description": "Create a TickTick reminder. Use instanceId from the reminders/list source to choose a TickTick list; omit it to create the reminder in Inbox. due_iso is an absolute RFC3339 instant and must include the requested wall time's real UTC offset (for example, 2026-08-27T14:30:00-07:00 for 2:30 PM in Los Angeles, never 14:30:00Z); timezone is the matching IANA name.",
          "parameters": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "description": "Reminder title."
              },
              "due_iso": {
                "type": "string",
                "format": "date-time",
                "description": "Optional RFC3339 instant. Include the requested local wall time and its real numeric UTC offset; do not append Z to a non-UTC local time."
              },
              "timezone": {
                "type": "string",
                "minLength": 1,
                "description": "IANA time-zone name used by TickTick. Required whenever due_iso is supplied."
              },
              "notify_before_ms": {
                "type": "integer",
                "minimum": 0,
                "description": "Optional notification lead time in milliseconds. Ignored when no due time is supplied."
              },
              "instanceId": {
                "type": "string",
                "description": "Optional TickTick project ID from the reminders/list source. Omit for Inbox."
              }
            },
            "required": [
              "title"
            ],
            "allOf": [
              {
                "if": {
                  "required": [
                    "due_iso"
                  ]
                },
                "then": {
                  "required": [
                    "timezone"
                  ]
                }
              }
            ],
            "additionalProperties": false
          },
          "targets": [
            "reminders/list"
          ],
          "destructive": false,
          "requiresConfirmation": false,
          "callerPermissions": []
        }
      ],
      "oauth": {
        "ticktick": {}
      }
    },
    "configPage": "config.html"
  }
}
